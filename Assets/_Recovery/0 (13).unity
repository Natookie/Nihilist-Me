--- !u!114 &2046594852
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2046594848}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e303b6657625d1439b6855e28d0ebd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlainMonologue
  monologueText:
  - "Mom made that hole so she could check if I was still\u2026 okay. She\u2019d
    slide food through it. I never asked her to stop."
  - "She still kneels by that hole every morning. I pretend not to hear her\u2026
    but I do. I always do."
  - "Late at night, I sometimes hear the TV leaking through it\u2014just a faint
    hum. I used to listen in to kill the boredom, but most nights it\u2019s just
    the news. "
