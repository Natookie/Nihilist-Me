  m_Script: {fileID: 11500000, guid: 5e303b6657625d1439b6855e28d0ebd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlainMonologue
  monologueText:
  - "I bought that poster for the concert I never went to\u2026 Had the ticket printed
    and everything."
  - "The guys on this poster look so alive. Crowds, lights, sweat\u2026 all that
    energy."
  - "I used to play his songs on repeat, thought I\u2019d see them live someday."
  - Acer Klin.
