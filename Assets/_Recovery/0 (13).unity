--- !u!114 &261154390
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 261154386}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e303b6657625d1439b6855e28d0ebd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlainMonologue
  monologueText:
  - "This basket used to hold clean clothes. I tried keeping things normal at first\u2026
    but eventually I ran out and stopped caring."
  - "Look at this mess. A whole basket of \u2018I\u2019ll deal with it later.\u2019
    I used to try, you know\u2014keeping track, separating clean from dirty. Now
    it\u2019s all just a single ecosystem."
  - "Funny thing\u2026 sometimes Joy curls up in here. Right on top of the shirts
    I haven\u2019t touched in months. I should be disgusted, but somehow it makes
    the room feel less empty."
