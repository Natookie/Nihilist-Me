--- !u!114 &1979287410
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1979287406}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e303b6657625d1439b6855e28d0ebd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlainMonologue
  monologueText:
  - "That little hole used to freak me out. First time I heard scratching, I nearly
    jumped out of my skin. Now it\u2019s just Joy\u2019s doorway."
  - "He used to steal crumbs, now he just wanders around like we\u2019re roommates."
  - "I should probably fix that wall\u2026 but Joy seems to like it. And\u2026 I
    don\u2019t mind the company."
