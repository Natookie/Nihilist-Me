  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e303b6657625d1439b6855e28d0ebd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlainMonologue
  monologueText:
  - "Stay Positive!\u2019 I should\u2019ve asked that poster where it buys its optimism."
  - "I used to actually look at this and try. Now it\u2019s just another thing collecting
    dust"
  - "Mom slapped that poster on my wall when she still believed a pep phrase could
    \u2018fix\u2019 me"
